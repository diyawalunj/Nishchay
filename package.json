{
  "name": "nishchay-defence",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js",
    "start": "node api/index.js",
    "migrate:firestore": "tsx scripts/migrate-content-to-firestore.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:rules": "mocha tests/firestore-rules.test.js --timeout 15000"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.2",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.7.0",
    "google-auth-library": "^10.6.2",
    "google-spreadsheet": "^5.2.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.14.0",
    "firebase-tools": "^15.34.2",
    "mocha": "^12.0.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "allowScripts": {
    "esbuild@0.27.2": true,
    "esbuild@0.25.12": true,
    "protobufjs@7.6.6": true,
    "@firebase/util": true
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "qs": "^6.17.1",
    "uuid": "^11.1.1",
    "glob": "^14.0.3",
    "minimatch": "^11.0.4",
    "@opentelemetry/core": "^2.8.0"
  }
}
