{
  "entities": {
    "user": {
      "title": "User",
      "description": "A user of the application.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The unique identifier for the user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The email address of the user."
        },
        "displayName": {
          "type": "string",
          "description": "The display name of the user."
        },
        "photoURL": {
          "type": "string",
          "description": "The URL of the user's profile photo."
        },
        "role": {
          "type": "string",
          "enum": ["admin", "user"],
          "description": "The role of the user."
        }
      },
      "required": ["uid", "email", "displayName"]
    },
    "doubt": {
      "title": "Doubt",
      "description": "A question submitted by a user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The UID of the user who submitted the doubt."
        },
        "name": {
          "type": "string",
          "description": "The name of the user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The email of the user."
        },
        "subject": {
          "type": "string",
          "description": "The subject of the doubt."
        },
        "message": {
          "type": "string",
          "description": "The content of the doubt."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The time the doubt was created."
        }
      },
      "required": ["uid", "name", "email", "subject", "message", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User profiles."
    },
    "/doubts/{doubtId}": {
      "schema": "doubt",
      "description": "Submitted doubts."
    }
  }
}
