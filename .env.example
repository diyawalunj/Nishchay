# Firebase Configuration (Vite + Server-side token verification)
# NOTE: VITE_FIREBASE_PROJECT_ID is also used server-side for Firebase Admin SDK token verification
VITE_FIREBASE_API_KEY=
# Firebase web API keys are visible in the browser by design; restrict them in Google Cloud API settings.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_ID=
# Optional public website origins used by the server CORS allowlist.
CLIENT_URL=https://your-domain.example
FRONTEND_URL=https://your-domain.example
# Server-only Firebase Admin credentials for Firestore content storage.
# Never prefix private credentials with VITE_ or commit their values.
FIREBASE_SERVICE_ACCOUNT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Firestore is the default store for all app content; set false only for legacy Sheets testing.
USE_FIRESTORE_CONTENT=true
# Google Sheets & Google Drive Configuration
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID_CONTACT=
